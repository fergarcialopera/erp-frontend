# URL base del backend (sin basepath). En dev sin esto, se usa proxy a localhost:8000.
VITE_API_BASE_URL=http://localhost:8000

# BasePath de la API. Por defecto /api/v1. Si tu backend usa otro (ej. /api), descomenta:
# VITE_API_BASEPATH=/api

# Formato del body de login. Si Postman usa form-urlencoded, pon "form".
# Valores: json (por defecto) | form
# VITE_LOGIN_FORMAT=form

# Campo de usuario: "email" o "username". Si el backend espera "username", descomenta:
# VITE_LOGIN_USER_FIELD=username
