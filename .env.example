# --- Desarrollo (opcional: copiar a .env.local) ---
# Sin .env en dev, Vite usa proxy: frontend :8081 → backend :8080 con rutas /api/v1.
# VITE_API_BASE_URL=http://localhost:8080
# VITE_API_BASEPATH=/api/v1

# --- Producción (.env.production, usado por `npm run build`) ---
# Mismo dominio: dejar vacío para rutas relativas /api/v1.
# VITE_API_BASE_URL=
# VITE_API_BASEPATH=/api/v1

# Formato del body de login. Valores: json (por defecto) | form
# VITE_LOGIN_FORMAT=form

# Campo de usuario: "email" o "username"
# VITE_LOGIN_USER_FIELD=username
